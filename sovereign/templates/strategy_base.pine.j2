//@version=6
strategy(
    title        = "{{ title }}",
    overlay      = true,
    default_qty_type  = strategy.percent_of_equity,
    default_qty_value = {{ position_pct | default(10) }},
    commission_type   = strategy.commission.percent,
    commission_value  = 0.05,
    slippage     = 2,
    pyramiding   = 0
)

// ── PARAMÈTRES ──────────────────────────────────────────────────
ema_fast    = input.int({{ params.ema_fast }},    "EMA Rapide",    minval=2)
ema_slow    = input.int({{ params.ema_slow }},    "EMA Lente",     minval=5)
kijun       = input.int({{ params.kijun }},       "Kijun",         minval=9)
atr_length  = input.int({{ params.atr_length }},  "ATR Length",    minval=5)
atr_mult    = input.float({{ params.atr_mult }},  "ATR Mult SL",   step=0.1)
ema_sep_min = input.float({{ params.ema_sep_min }},"EMA Sep Min %", step=0.05)
cooldown_n  = input.int({{ params.cooldown }},    "Cooldown bars", minval=0)
atr_min_pct = input.float({{ params.atr_min_pct }},"ATR Min %",    step=0.05)
rr_ratio    = input.float({{ params.rr_ratio }},  "RR Ratio",      step=0.5)
adx_min     = input.int({{ params.adx_min }},     "ADX Min",       minval=0)
{% if use_rsi %}
rsi_len     = input.int(14, "RSI Length", minval=2)
rsi_ob      = input.int(70, "RSI OB",     minval=50)
rsi_os      = input.int(30, "RSI OS",     maxval=50)
{% endif %}

// ── INDICATEURS ─────────────────────────────────────────────────
ema_f = ta.ema(close, ema_fast)
ema_s = ta.ema(close, ema_slow)
kij   = ta.ema(close, kijun)
atr   = ta.atr(atr_length)

[di_plus, di_minus, adx_val] = ta.dmi(14, 14)

ema_sep = math.abs(ema_f - ema_s) / ema_s * 100
atr_pct = atr / close * 100
{% if use_rsi %}
rsi_val = ta.rsi(close, rsi_len)
{% endif %}

// ── FILTRES ─────────────────────────────────────────────────────
trend_up   = ema_f > ema_s and close > kij
trend_down = ema_f < ema_s and close < kij
sep_ok     = ema_sep >= ema_sep_min
atr_ok     = atr_pct >= atr_min_pct
adx_ok     = adx_val >= adx_min
{% if use_rsi %}
rsi_long_ok  = rsi_val < rsi_ob
rsi_short_ok = rsi_val > rsi_os
{% else %}
rsi_long_ok  = true
rsi_short_ok = true
{% endif %}

// Cooldown
var int last_entry = 0
cooldown_ok = bar_index - last_entry >= cooldown_n

// ── SIGNAUX ─────────────────────────────────────────────────────
long_signal  = trend_up   and sep_ok and atr_ok and adx_ok and rsi_long_ok  and cooldown_ok and ta.crossover(ema_f, kij)
short_signal = trend_down and sep_ok and atr_ok and adx_ok and rsi_short_ok and cooldown_ok and ta.crossunder(ema_f, kij)

// ── ENTRIES ─────────────────────────────────────────────────────
if long_signal
    sl_long = close - atr * atr_mult
    tp_long = close + (close - sl_long) * rr_ratio
    strategy.entry("L", strategy.long)
    strategy.exit("L_exit", "L", stop=sl_long, limit=tp_long)
    last_entry := bar_index

if short_signal
    sl_short = close + atr * atr_mult
    tp_short = close - (sl_short - close) * rr_ratio
    strategy.entry("S", strategy.short)
    strategy.exit("S_exit", "S", stop=sl_short, limit=tp_short)
    last_entry := bar_index

// ── VISUALISATION ───────────────────────────────────────────────
plot(ema_f, "EMA Fast", color=color.new(color.green, 0), linewidth=1)
plot(ema_s, "EMA Slow",  color=color.new(color.red,   0), linewidth=1)
plot(kij,   "Kijun",     color=color.new(color.blue,  0), linewidth=1)

bgcolor(long_signal  ? color.new(color.green, 88) : na)
bgcolor(short_signal ? color.new(color.red,   88) : na)
