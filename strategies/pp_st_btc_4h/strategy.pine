//@version=6
// ═══════════════════════════════════════════════════════════════
// PP-ST + EMA200 + ADX — BTC 4H Long Only  ★ VERSION FINALE ★
// ─────────────────────────────────────────────────────────────
// Backtest BINANCE:BTCUSDT 4H (2020-2026) :
//   +2947% | DD 24.53% | PF 2.52 | 59 trades | WR 33.9%
//
// Architecture :
//   SIGNAL  : Pivot Point SuperTrend crossover (prd=2, F=5, ATR=14)
//   FILTRE 1: EMA200 macro (Long only si price > EMA200)
//   FILTRE 2: ADX ≥ 20 (marché en trend, pas en range)
//   SORTIE  : Retournement PP-ST OU passage sous EMA200
//
// Prouvé supérieur aux scripts : ST 4.11.2, ST Sandwich, PP×QT v2.1
// ═══════════════════════════════════════════════════════════════
strategy("PP-ST + EMA200 + ADX — BTC 4H", overlay=true, shorttitle="PP-ST-A",
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=1)

// ── Inputs
prd    = input.int(2,    "Pivot Period", minval=1, maxval=50, group="PP SuperTrend")
Factor = input.float(5.0,"ATR Factor",  minval=1, step=0.1,  group="PP SuperTrend")
Pd     = input.int(14,   "ATR Period",  minval=1,            group="PP SuperTrend")
adxMin = input.int(20,   "ADX Min",     minval=1,            group="Filtres")

// ── Pivot Points → Centre pondéré
float ph = ta.pivothigh(prd, prd)
float pl = ta.pivotlow(prd, prd)

var float center = na
float lastpp = not na(ph) ? ph : not na(pl) ? pl : na
if not na(lastpp)
    center := na(center) ? lastpp : (center * 2 + lastpp) / 3

// ── Bandes + Trend
float Up = center - Factor * ta.atr(Pd)
float Dn = center + Factor * ta.atr(Pd)

var float TUp   = na
var float TDown = na
var int   Trend = 1

TUp   := nz(close[1]) > nz(TUp[1])   ? math.max(Up, nz(TUp[1]))   : Up
TDown := nz(close[1]) < nz(TDown[1]) ? math.min(Dn, nz(TDown[1])) : Dn
Trend := close > nz(TDown[1]) ? 1 : close < nz(TUp[1]) ? -1 : nz(Trend[1], 1)

float TrailSL    = Trend == 1 ? TUp : TDown

// ── Filtres
float ema200     = ta.ema(close, 200)
bool  bull_macro = close > ema200
[_, _, adxVal]   = ta.dmi(14, 14)
bool trending    = adxVal >= adxMin

// ── Signaux
bool buy  = Trend == 1 and nz(Trend[1]) == -1 and bull_macro and trending
bool sell = Trend == -1 and nz(Trend[1]) == 1

// ── Ordres (alert_message JSON — format attendu par webhook_server.py)
if buy
    strategy.entry("Long", strategy.long,
         alert_message='{"setup":"A*","dir":"LONG","ticker":"{{ticker}}","tf":"{{interval}}","price":"{{close}}","exchange":"{{exchange}}"}')
if sell or (strategy.position_size > 0 and not bull_macro)
    strategy.close("Long",
         alert_message='{"setup":"B","dir":"CLOSE","ticker":"{{ticker}}","tf":"{{interval}}","price":"{{close}}","exchange":"{{exchange}}"}')

// ── Visualisation
lc = Trend == 1 ? color.lime : color.red
plot(TrailSL, color=lc, linewidth=2, title="PP-ST")
plot(ema200,  color=color.new(color.orange, 0), linewidth=1, title="EMA200")
bgcolor(trending ? na : color.new(color.gray, 94), title="ADX Range zone")
plotshape(buy  ? TrailSL : na, "Buy",  shape.labelup,   location.absolute, color.lime, textcolor=color.black, text="▲ LONG", size=size.small)
plotshape(sell ? TrailSL : na, "Exit", shape.labeldown, location.absolute, color.orange, textcolor=color.white, text="EXIT",   size=size.tiny)
