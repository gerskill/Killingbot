//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// 🏛️ STOIC LENS PURE v2 — protocole @StoicTA, rien d'autre
// ───────────────────────────────────────────────────────────────────────────
// Aucun PP-ST, aucun SuperTrend, aucun ADX, aucun RSI, aucun z-score volume.
// Uniquement les 4 piliers du protocole + les 2 setups autorisés.
//
// ⚠️ CORRECTIF vs stoic_lens_strategy.pine (v1.0, 2026-06-06) :
//    v1 codait  hcom = pdc > pdo  → c'est juste "bougie verte hier".
//    Le protocole définit HCOM = Highest daily CLOSE of the Month.
//    Le Pilier 1 (Tier 1, le plus important) était donc faux dans v1.
//    v2 calcule le vrai plus-haut/plus-bas close journalier du mois courant.
//
// PILIERS   : P1 extrême mensuel (HCOM/LCOM) · P2 biais SMA20/200
//             P3 niveau daily (PDH/PDL/PDC)  · P4 zone Fib 50–61.8%
// SETUPS    : BnR (continuation) · SFP (reversal / trapped traders)
// SEUILS    : 4/4 Golden SBS (risque 1%) · 3/4 standard (0.5%) · <3 = NO TRADE
// GESTION   : T1 → 50% + breakeven · T2 → 25% · T3 runner trail
// ═══════════════════════════════════════════════════════════════════════════
strategy("🏛️ Stoic Lens Pure v2", overlay=true, shorttitle="STOIC-P2",
     initial_capital   = 10000,
     default_qty_type  = strategy.cash,
     commission_type   = strategy.commission.percent, commission_value = 0.04,
     slippage          = 2,
     max_bars_back     = 1000,
     pyramiding        = 0)

// ── Inputs ─────────────────────────────────────────────────────────────────
gP = "Piliers — seuils"
minScore   = input.int(3,     "Score minimum (3=standard, 4=Golden SBS)", minval=2, maxval=4, group=gP)
lvlTolAtr  = input.float(0.5, "Proximité niveau (×ATR)",  step=0.1, minval=0.1, group=gP)
fibLo      = input.float(0.50,"Fib zone basse",           step=0.01, group=gP)
fibHi      = input.float(0.618,"Fib zone haute",          step=0.01, group=gP)

gS = "Setups"
useBnR     = input.bool(true, "Setup 1 — Break & Retest", group=gS)
useSFP     = input.bool(true, "Setup 2 — SFP / Sweep",    group=gS)
swingLen   = input.int(10,    "Longueur swing (pivots)",  minval=3, group=gS)

gN = "No Edge Zone"
noEdgePct  = input.float(0.35,"Zone centrale interdite (% du range daily)", minval=0.0, maxval=0.6, step=0.05, group=gN)
minAtrPct  = input.float(0.05,"Volatilité min (ATR/prix %)", minval=0.0, step=0.01, group=gN)

gR = "Risque & gestion"
riskGolden = input.float(1.0, "Risque 4/4 Golden (%)",    step=0.25, group=gR)
riskStd    = input.float(0.5, "Risque 3/4 standard (%)",  step=0.25, group=gR)
atrLen     = input.int(14,    "ATR longueur",             group=gR)
slBufAtr   = input.float(0.3, "Buffer stop (×ATR)",       step=0.1, group=gR)
t1R        = input.float(2.0, "T1 (R)",  step=0.5, group=gR)
t2R        = input.float(3.0, "T2 (R)",  step=0.5, group=gR)
t3R        = input.float(5.0, "T3 (R)",  step=0.5, group=gR)
maxLossDay = input.int(2,     "Stop journée après N pertes", minval=1, maxval=5, group=gR)

gT = "Sessions (UTC)"
useSession = input.bool(false,"Filtrer par session",      group=gT)
sessStartH = input.int(3,     "Début (h UTC — London)",   minval=0, maxval=23, group=gT)
sessEndH   = input.int(16,    "Fin (h UTC — NY)",         minval=0, maxval=23, group=gT)

// ── TIER 1 — Extrêmes mensuels : HCOM / LCOM ───────────────────────────────
// Le protocole insiste : CLOSE, jamais le wick. Le wick = réaction émotionnelle,
// le close = acceptance réelle. On suit donc le plus haut/bas CLOSE JOURNALIER
// depuis le début du mois courant.
monthlyExtremes() =>
    var float hc = na
    var float lc = na
    bool newMonth = ta.change(time("M")) != 0
    if newMonth
        hc := close
        lc := close
    else
        hc := na(hc) ? close : math.max(hc, close)
        lc := na(lc) ? close : math.min(lc, close)
    [hc, lc]

[hcom, lcom] = request.security(syminfo.tickerid, "D", monthlyExtremes(), lookahead = barmerge.lookahead_off)

// ── TIER 2 — Niveaux daily ─────────────────────────────────────────────────
pdh = request.security(syminfo.tickerid, "D", high[1],  lookahead = barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],   lookahead = barmerge.lookahead_off)
pdc = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_off)

// ── TIER 4 — Dynamique : SMA 20 / 200 ──────────────────────────────────────
sma20  = ta.sma(close, 20)
sma200 = ta.sma(close, 200)

atrNow = ta.atr(atrLen)
tol    = lvlTolAtr * atrNow

// ── PILIER 2 — Biais SMA ───────────────────────────────────────────────────
// Prix > SMA20 > SMA200 = LONG · Prix < SMA20 < SMA200 = SHORT · sinon NO EDGE
bool biasLong  = close > sma20 and sma20 > sma200
bool biasShort = close < sma20 and sma20 < sma200
bool noBias    = not biasLong and not biasShort

// ── PILIER 1 — Extrême mensuel ─────────────────────────────────────────────
// Long si on travaille depuis le LCOM (trapped sellers), short depuis le HCOM.
bool p1Long  = not na(lcom) and math.abs(close - lcom) <= tol * 2
bool p1Short = not na(hcom) and math.abs(close - hcom) <= tol * 2

// ── PILIER 3 — Niveau daily ────────────────────────────────────────────────
bool nearPdl = math.abs(close - pdl) <= tol
bool nearPdh = math.abs(close - pdh) <= tol
bool nearPdc = math.abs(close - pdc) <= tol
bool p3Long  = nearPdl or nearPdc
bool p3Short = nearPdh or nearPdc

// ── PILIER 4 — Zone Fib 50–61.8% du dernier swing ──────────────────────────
float ph = ta.pivothigh(high, swingLen, swingLen)
float pl = ta.pivotlow(low,  swingLen, swingLen)
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

float rng = (not na(lastPH) and not na(lastPL)) ? lastPH - lastPL : na
// Long : retracement depuis le haut vers 50–61.8% de la jambe haussière
float fibLoLong  = not na(rng) ? lastPH - rng * fibHi : na
float fibHiLong  = not na(rng) ? lastPH - rng * fibLo : na
bool  p4Long     = not na(rng) and rng > 0 and close >= fibLoLong and close <= fibHiLong
// Short : retracement depuis le bas vers 50–61.8% de la jambe baissière
float fibLoShort = not na(rng) ? lastPL + rng * fibLo : na
float fibHiShort = not na(rng) ? lastPL + rng * fibHi : na
bool  p4Short    = not na(rng) and rng > 0 and close >= fibLoShort and close <= fibHiShort

// ── SCORING 4 PILIERS ──────────────────────────────────────────────────────
int scoreLong  = (p1Long  ? 1 : 0) + (biasLong  ? 1 : 0) + (p3Long  ? 1 : 0) + (p4Long  ? 1 : 0)
int scoreShort = (p1Short ? 1 : 0) + (biasShort ? 1 : 0) + (p3Short ? 1 : 0) + (p4Short ? 1 : 0)

// ── NO EDGE ZONE ───────────────────────────────────────────────────────────
// "Un bon lens dit souvent : PAS DE TRADE. C'est une feature, pas un bug."
float dayRange = pdh - pdl
float dayMid   = (pdh + pdl) / 2
bool  midRange = dayRange > 0 and math.abs(close - dayMid) < dayRange * noEdgePct / 2
bool  tooQuiet = (atrNow / close * 100) < minAtrPct
int   hUTC     = hour(time, "UTC")
bool  inSess   = not useSession or (sessStartH <= sessEndH ? (hUTC >= sessStartH and hUTC < sessEndH) : (hUTC >= sessStartH or hUTC < sessEndH))
bool  noEdge   = midRange or tooQuiet or noBias or not inSess

// ── SETUPS — deux, pas un de plus ──────────────────────────────────────────
// Setup 1 · Break & Retest : cassure d'un niveau meaningful puis retest tenu
bool bnrLong  = useBnR and ((close[1] < pdc and close >= pdc and low  <= pdc + tol) or (close[1] < pdh and close >= pdh and low  <= pdh + tol))
bool bnrShort = useBnR and ((close[1] > pdc and close <= pdc and high >= pdc - tol) or (close[1] > pdl and close <= pdl and high >= pdl - tol))

// Setup 2 · SFP / Sweep : mèche au-delà du niveau, clôture rejetée → trapped
bool sfpLong  = useSFP and ((low  < pdl  and close > pdl  and close > open) or (not na(lcom) and low  < lcom and close > lcom and close > open))
bool sfpShort = useSFP and ((high > pdh  and close < pdh  and close < open) or (not na(hcom) and high > hcom and close < hcom and close < open))

bool patternLong  = bnrLong  or sfpLong
bool patternShort = bnrShort or sfpShort

// ── Circuit breaker : 2 pertes consécutives → stop journée ─────────────────
var int lossStreak = 0
var int lastClosed = 0
if strategy.closedtrades > lastClosed
    for i = lastClosed to strategy.closedtrades - 1
        lossStreak := strategy.closedtrades.profit(i) < 0 ? lossStreak + 1 : 0
    lastClosed := strategy.closedtrades
bool newDay = ta.change(time("D")) != 0
if newDay
    lossStreak := 0
bool dayBlocked = lossStreak >= maxLossDay

// ── Signaux finaux ─────────────────────────────────────────────────────────
bool goLong  = not noEdge and not dayBlocked and patternLong  and scoreLong  >= minScore and strategy.position_size == 0
bool goShort = not noEdge and not dayBlocked and patternShort and scoreShort >= minScore and strategy.position_size == 0

// ── Exécution ──────────────────────────────────────────────────────────────
// Stop DERRIÈRE la structure (invalidation prédéfinie), jamais un stop arbitraire.
float slLong  = math.min(low,  nz(lastPL, low))  - slBufAtr * atrNow
float slShort = math.max(high, nz(lastPH, high)) + slBufAtr * atrNow

if goLong
    float risk = close - slLong
    if risk > 0
        float rPct = scoreLong >= 4 ? riskGolden : riskStd
        float qty  = strategy.equity * rPct / 100 / risk
        strategy.entry("L", strategy.long, qty = qty,
             alert_message = '{"setup":"STOIC","dir":"LONG","ticker":"{{ticker}}","tf":"{{interval}}","price":"{{close}}","exchange":"{{exchange}}"}')
        strategy.exit("L-T1", "L", qty_percent = 50, stop = slLong, limit = close + t1R * risk)
        strategy.exit("L-T2", "L", qty_percent = 50, stop = slLong, limit = close + t2R * risk)
        strategy.exit("L-T3", "L",                   stop = slLong, limit = close + t3R * risk)

if goShort
    float risk = slShort - close
    if risk > 0
        float rPct = scoreShort >= 4 ? riskGolden : riskStd
        float qty  = strategy.equity * rPct / 100 / risk
        strategy.entry("S", strategy.short, qty = qty,
             alert_message = '{"setup":"STOIC","dir":"SHORT","ticker":"{{ticker}}","tf":"{{interval}}","price":"{{close}}","exchange":"{{exchange}}"}')
        strategy.exit("S-T1", "S", qty_percent = 50, stop = slShort, limit = close - t1R * risk)
        strategy.exit("S-T2", "S", qty_percent = 50, stop = slShort, limit = close - t2R * risk)
        strategy.exit("S-T3", "S",                   stop = slShort, limit = close - t3R * risk)

// Breakeven après T1 : "protéger les gains, pas couper le runner"
float entryP = strategy.position_avg_price
float initR  = strategy.position_size > 0 ? entryP - slLong : slShort - entryP
if strategy.position_size > 0 and initR > 0 and high >= entryP + t1R * initR
    strategy.exit("L-BE", "L", stop = entryP)
if strategy.position_size < 0 and initR > 0 and low  <= entryP - t1R * initR
    strategy.exit("S-BE", "S", stop = entryP)

// ── Visualisation ──────────────────────────────────────────────────────────
plot(hcom,   "HCOM", color = color.new(color.red,   20), style = plot.style_linebr, linewidth = 2)
plot(lcom,   "LCOM", color = color.new(color.green, 20), style = plot.style_linebr, linewidth = 2)
plot(pdh,    "PDH",  color = color.new(color.orange, 55), style = plot.style_linebr)
plot(pdl,    "PDL",  color = color.new(color.orange, 55), style = plot.style_linebr)
plot(pdc,    "PDC",  color = color.new(color.gray,   45), style = plot.style_linebr)
plot(sma20,  "SMA20",  color = color.new(color.aqua, 30))
plot(sma200, "SMA200", color = color.new(color.fuchsia, 30), linewidth = 2)
bgcolor(noEdge     ? color.new(color.gray, 92) : na, title = "No Edge Zone")
bgcolor(dayBlocked ? color.new(color.red,  88) : na, title = "Journee bloquee")
plotshape(goLong  and scoreLong  >= 4, "Golden Long",  shape.labelup,   location.belowbar, color.lime,  text = "SBS", textcolor = color.black, size = size.small)
plotshape(goLong  and scoreLong  == 3, "Long",         shape.triangleup, location.belowbar, color.green, size = size.tiny)
plotshape(goShort and scoreShort >= 4, "Golden Short", shape.labeldown, location.abovebar, color.red,   text = "SBS", textcolor = color.white, size = size.small)
plotshape(goShort and scoreShort == 3, "Short",        shape.triangledown, location.abovebar, color.maroon, size = size.tiny)

// ── Tableau de session ─────────────────────────────────────────────────────
// Ligne P1/P2/P3/P4 : 1 = pilier validé, 0 = pilier absent.
var table tbl = table.new(position.top_right, 2, 8, border_width = 1)
if barstate.islast
    table.cell(tbl, 0, 0, "STOIC LENS", text_color = color.white, bgcolor = color.new(color.black, 20))
    table.cell(tbl, 1, 0, noEdge ? "NO EDGE" : (scoreLong >= scoreShort ? "LONG " + str.tostring(scoreLong) + "/4" : "SHORT " + str.tostring(scoreShort) + "/4"), text_color = color.white, bgcolor = noEdge ? color.new(color.gray, 30) : color.new(color.teal, 30))
    table.cell(tbl, 0, 1, "HCOM")
    table.cell(tbl, 1, 1, str.tostring(hcom, format.mintick))
    table.cell(tbl, 0, 2, "LCOM")
    table.cell(tbl, 1, 2, str.tostring(lcom, format.mintick))
    table.cell(tbl, 0, 3, "PDH")
    table.cell(tbl, 1, 3, str.tostring(pdh, format.mintick))
    table.cell(tbl, 0, 4, "PDL")
    table.cell(tbl, 1, 4, str.tostring(pdl, format.mintick))
    table.cell(tbl, 0, 5, "PDC")
    table.cell(tbl, 1, 5, str.tostring(pdc, format.mintick))
    table.cell(tbl, 0, 6, "Biais")
    table.cell(tbl, 1, 6, biasLong ? "LONG" : biasShort ? "SHORT" : "NO EDGE")
    table.cell(tbl, 0, 7, "P1/P2/P3/P4")
    table.cell(tbl, 1, 7, (p1Long or p1Short ? "1" : "0") + (noBias ? "0" : "1") + (p3Long or p3Short ? "1" : "0") + (p4Long or p4Short ? "1" : "0"))

// ── Alertes ────────────────────────────────────────────────────────────────
alertcondition(goLong,  "Stoic Long",  "STOIC LONG signal")
alertcondition(goShort, "Stoic Short", "STOIC SHORT signal")
