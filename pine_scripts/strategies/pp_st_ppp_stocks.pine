//@version=6
// ═══════════════════════════════════════════════════════════════
// PP-ST + EMA200 + ADX + filtre PPP — ACTIONS, Long Only
// ─────────────────────────────────────────────────────────────
// Base : pp_st_btc_4h_final.pine (logique PP-ST / EMA200 / ADX identique).
// Ajout : on n'entre que si le Potential Payback Period (PPP) de l'action
// est sous un seuil fixé à l'avance.
//
//   PPP = n tel que  PER = (qⁿ − 1)/(q − 1),  q = (1+g)/(1+r)
//   → n = ln[PER·(q−1) + 1] / ln q
//   Cas limites : g = r → PPP = PER
//                 g < r et PER ≥ (1+r)/(r−g) → jamais remboursé (filtre KO)
//
//   EPS  : bénéfice par action dilué TTM (request.financial)
//   g    : CAGR de l'EPS annuel (FY) sur N exercices publiés, plafonné
//   r    : taux d'actualisation fixe (input)
//
// STATUT : non vérifié. Ni walk-forward, ni Strategy Tester à ce jour.
// Ne fonctionne que sur des actions (pas de bénéfices sur crypto / forex).
// Comparer chaque actif avec "Activer le filtre PPP" ON puis OFF.
// ═══════════════════════════════════════════════════════════════
strategy("PP-ST + EMA200 + ADX + PPP — Actions", overlay=true, shorttitle="PP-ST-PPP",
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=1)

// ── Inputs
prd    = input.int(2,    "Pivot Period", minval=1, maxval=50, group="PP SuperTrend")
Factor = input.float(5.0,"ATR Factor",  minval=1, step=0.1,  group="PP SuperTrend")
Pd     = input.int(14,   "ATR Period",  minval=1,            group="PP SuperTrend")
adxMin = input.int(20,   "ADX Min",     minval=1,            group="Filtres")

usePPP  = input.bool(true,  "Activer le filtre PPP",                       group="PPP")
pppMax  = input.float(10.0, "PPP max (années)",       minval=1, step=0.5,  group="PPP")
rPct    = input.float(8.0,  "r — taux d'actualisation %", minval=0, step=0.5, group="PPP")
gMode   = input.string("CAGR EPS", "Source de g", options=["CAGR EPS", "Manuel"], group="PPP")
gManPct = input.float(10.0, "g manuel %",             step=0.5,            group="PPP")
gYears  = input.int(3,      "CAGR sur N exercices",   minval=1, maxval=10, group="PPP")
gCapPct = input.float(25.0, "Plafond de g %",         minval=0, step=1,    group="PPP")
showTab = input.bool(true,  "Afficher le tableau",                         group="PPP")

// ── Pivot Points → Centre pondéré
float ph = ta.pivothigh(prd, prd)
float pl = ta.pivotlow(prd, prd)

var float center = na
float lastpp = not na(ph) ? ph : not na(pl) ? pl : na
if not na(lastpp)
    center := na(center) ? lastpp : (center * 2 + lastpp) / 3

// ── Bandes + Trend
float Up = center - Factor * ta.atr(Pd)
float Dn = center + Factor * ta.atr(Pd)

var float TUp   = na
var float TDown = na
var int   Trend = 1

TUp   := nz(close[1]) > nz(TUp[1])   ? math.max(Up, nz(TUp[1]))   : Up
TDown := nz(close[1]) < nz(TDown[1]) ? math.min(Dn, nz(TDown[1])) : Dn
Trend := close > nz(TDown[1]) ? 1 : close < nz(TUp[1]) ? -1 : nz(Trend[1], 1)

float TrailSL    = Trend == 1 ? TUp : TDown

// ── Filtres techniques
float ema200     = ta.ema(close, 200)
bool  bull_macro = close > ema200
[_, _, adxVal]   = ta.dmi(14, 14)
bool trending    = adxVal >= adxMin

// ── Fondamentaux
float epsTTM = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE_DILUTED", "TTM", ignore_invalid_symbol=true)
float epsFY  = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE_DILUTED", "FY",  ignore_invalid_symbol=true)

// Historique des EPS annuels dans l'ordre de publication (point-in-time sur le graphique)
var array<float> fyHist = array.new<float>()
if not na(epsFY) and (array.size(fyHist) == 0 or epsFY != array.get(fyHist, array.size(fyHist) - 1))
    array.push(fyHist, epsFY)
    if array.size(fyHist) > 11
        array.shift(fyHist)

f_cagr() =>
    float res = na
    int sz = array.size(fyHist)
    if sz >= 2
        int k = math.min(gYears, sz - 1)
        float last  = array.get(fyHist, sz - 1)
        float first = array.get(fyHist, sz - 1 - k)
        if last > 0 and first > 0
            res := math.pow(last / first, 1.0 / k) - 1
    res

float gRaw = gMode == "Manuel" ? gManPct / 100 : f_cagr()
float g    = na(gRaw) ? na : math.min(gRaw, gCapPct / 100)
float r    = rPct / 100
float per  = epsTTM > 0 ? close / epsTTM : na

// PPP en années ; 999 = jamais remboursé ; na = non calculable (EPS ≤ 0, g inconnu)
f_ppp(float _per, float _g, float _r) =>
    float res = na
    if not na(_per) and not na(_g) and _per > 0
        float q = (1 + _g) / (1 + _r)
        if math.abs(q - 1) < 1e-9
            res := _per
        else
            float arg = _per * (q - 1) + 1
            res := arg <= 0 ? 999.0 : math.log(arg) / math.log(q)
    res

float ppp   = f_ppp(per, g, r)
bool  pppOK = not usePPP or (not na(ppp) and ppp <= pppMax)

// ── Signaux
bool buy  = Trend == 1 and nz(Trend[1]) == -1 and bull_macro and trending and pppOK
bool sell = Trend == -1 and nz(Trend[1]) == 1

// ── Ordres (alert_message JSON — format attendu par webhook_server.py)
if buy
    strategy.entry("Long", strategy.long,
         alert_message='{"setup":"A*PPP","dir":"LONG","ticker":"{{ticker}}","tf":"{{interval}}","price":"{{close}}","exchange":"{{exchange}}"}')
if sell or (strategy.position_size > 0 and not bull_macro)
    strategy.close("Long",
         alert_message='{"setup":"B","dir":"CLOSE","ticker":"{{ticker}}","tf":"{{interval}}","price":"{{close}}","exchange":"{{exchange}}"}')

// ── Visualisation
lc = Trend == 1 ? color.lime : color.red
plot(TrailSL, color=lc, linewidth=2, title="PP-ST")
plot(ema200,  color=color.new(color.orange, 0), linewidth=1, title="EMA200")
bgcolor(trending ? na : color.new(color.gray, 94), title="ADX Range zone")
bgcolor(usePPP and not pppOK ? color.new(color.red, 95) : na, title="PPP trop cher")
plotshape(buy  ? TrailSL : na, "Buy",  shape.labelup,   location.absolute, color.lime, textcolor=color.black, text="▲ LONG", size=size.small)
plotshape(sell ? TrailSL : na, "Exit", shape.labeldown, location.absolute, color.orange, textcolor=color.white, text="EXIT",   size=size.tiny)

var table tab = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 20), border_width=1)
if showTab and barstate.islast
    string pppTxt = na(ppp) ? "n/a" : ppp >= 999 ? "jamais" : str.tostring(ppp, "#.0") + " ans"
    table.cell(tab, 0, 0, "EPS TTM", text_color=color.white)
    table.cell(tab, 1, 0, na(epsTTM) ? "n/a" : str.tostring(epsTTM, "#.##"), text_color=color.white)
    table.cell(tab, 0, 1, "g", text_color=color.white)
    table.cell(tab, 1, 1, na(g) ? "n/a" : str.tostring(g * 100, "#.0") + " %", text_color=color.white)
    table.cell(tab, 0, 2, "PER", text_color=color.white)
    table.cell(tab, 1, 2, na(per) ? "n/a" : str.tostring(per, "#.0"), text_color=color.white)
    table.cell(tab, 0, 3, "PPP", text_color=color.white)
    table.cell(tab, 1, 3, pppTxt, text_color=pppOK ? color.lime : color.red)
    table.cell(tab, 0, 4, "Filtre", text_color=color.white)
    table.cell(tab, 1, 4, usePPP ? (pppOK ? "OK" : "bloque") : "OFF", text_color=color.white)
