//@version=6
// ═══════════════════════════════════════════════════════════════
// EWMA Vol Sizer — Approximation Pine du module GARCH (Layer 6)
// ─────────────────────────────────────────────────────────────
// Le vrai GARCH(1,1) tourne côté Python (agents/garch_position_sizer.py,
// via MLE avec la librairie `arch`). Pine Script ne peut pas faire
// d'optimisation par maximum de vraisemblance en natif — cet indicateur
// fournit une APPROXIMATION visuelle on-chart : variance EWMA
// (RiskMetrics, lambda=0.94), percentile de régime, et un multiplicateur
// de taille de position affiché dans un dashboard.
//
// Usage : ajouter à côté de n'importe quelle stratégie KB_*/PP-ST pour
// visualiser le régime de volatilité et le multiplicateur suggéré avant
// d'appliquer le vrai calcul GARCH (Python) au sizing réel.
// ═══════════════════════════════════════════════════════════════
indicator("EWMA Vol Sizer (GARCH approx)", overlay=false, shorttitle="VolSizer")

// ── Inputs
lambda_ewma   = input.float(0.94, "Lambda (RiskMetrics)", minval=0.80, maxval=0.99, step=0.01, group="Volatilité")
lookback_pct  = input.int(200,   "Lookback percentile régime", minval=30, group="Volatilité")
vol_target    = input.float(1.0, "Cible vol (%)", minval=0.1, step=0.1, group="Sizing")
mult_floor    = input.float(0.25,"Multiplicateur min", minval=0.05, step=0.05, group="Sizing")
mult_cap      = input.float(2.0, "Multiplicateur max", minval=0.5,  step=0.1,  group="Sizing")

// ── Rendements log (%) et variance EWMA
float ret_pct = math.log(close / close[1]) * 100.0
var float ewma_var = na
ewma_var := na(ewma_var[1]) ? ret_pct * ret_pct : lambda_ewma * ewma_var[1] + (1 - lambda_ewma) * ret_pct * ret_pct
float sigma_forecast = math.sqrt(ewma_var)

// ── Régime relatif (percentile-rank sur lookback) — clé pour la généralisation
// multi-actifs : on compare la vol à SON PROPRE historique plutôt qu'à un seuil
// fixe (qui ne transfère pas d'un actif à l'autre).
float vol_rank = ta.percentrank(sigma_forecast, lookback_pct)

string vol_regime = vol_rank >= 90 ? "EXTREME" : vol_rank >= 70 ? "HIGH" : vol_rank >= 30 ? "NORMAL" : "LOW"
color  regime_col = vol_rank >= 90 ? color.red : vol_rank >= 70 ? color.orange : vol_rank >= 30 ? color.gray : color.teal

// ── Multiplicateur de taille (identique à la logique Python, en local Pine)
float raw_mult   = sigma_forecast > 0 ? vol_target / sigma_forecast : 1.0
float size_mult  = math.max(mult_floor, math.min(mult_cap, raw_mult))

// ── Plots
plot(sigma_forecast, title="Sigma prévue (EWMA %)", color=color.new(color.blue, 0), linewidth=2)
hline(vol_target, "Vol cible", color=color.new(color.gray, 50), linestyle=hline.style_dashed)

// ── Dashboard
var table dash = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Régime Vol",      text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 0, vol_regime,        text_color=regime_col,  bgcolor=color.new(color.black, 0))
    table.cell(dash, 0, 1, "Sigma prévue (%)", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 1, str.tostring(sigma_forecast, "#.###"), text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 0, 2, "Percentile",       text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 2, str.tostring(vol_rank, "#.#") + "%", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 0, 3, "Size Multiplier",  text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 3, str.tostring(size_mult, "#.###") + "x", text_color=color.lime, bgcolor=color.new(color.black, 0))
